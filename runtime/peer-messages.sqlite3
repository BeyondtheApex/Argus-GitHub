{"$argus_sqlite":1,"schema":{"messages":{"sql":"CREATE TABLE messages (id TEXT PRIMARY KEY, sender TEXT NOT NULL, recipient TEXT NOT NULL, kind TEXT NOT NULL, reply_to TEXT NOT NULL, text TEXT NOT NULL, evidence_refs TEXT NOT NULL, parent_call_id TEXT NOT NULL, mission_id TEXT, created_at REAL NOT NULL, acknowledged_at REAL NOT NULL DEFAULT 0, attempts INTEGER NOT NULL DEFAULT 0, next_attempt_at REAL NOT NULL DEFAULT 0, last_error TEXT NOT NULL DEFAULT '')","table":"messages","type":"table"},"peer_pending":{"sql":"CREATE INDEX peer_pending ON messages(recipient,acknowledged_at,next_attempt_at,created_at)","table":"messages","type":"index"},"peer_reply":{"sql":"CREATE UNIQUE INDEX peer_reply ON messages(reply_to) WHERE kind='reply'","table":"messages","type":"index"},"receipts":{"sql":"CREATE TABLE receipts (message_id TEXT PRIMARY KEY, processed_at REAL NOT NULL, payload TEXT NOT NULL)","table":"receipts","type":"table"}},"sequences":{},"tables":{"messages":{"columns":["id","sender","recipient","kind","reply_to","text","evidence_refs","parent_call_id","mission_id","created_at","acknowledged_at","attempts","next_attempt_at","last_error"],"primary_key":["id"],"rows":{}},"receipts":{"columns":["message_id","processed_at","payload"],"primary_key":["message_id"],"rows":{}}}}
